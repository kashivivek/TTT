# Environment variables (copy to .env.local and fill in values)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
TMDB_API_KEY=your_tmdb_api_key
NEXT_PUBLIC_SITE_URL=https://tvtime.online

# Server-only: account deletion, daily new-episode job, push lookups
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate_a_long_random_string

# AI suggestions
GROQ_API_KEY=your_groq_key

# Email (feedback, deletion notices, new-episode digests).
# Digests to users need a verified sending domain in Resend (onboarding@resend.dev only reaches your own inbox).
RESEND_API_KEY=your_resend_key
RESEND_FROM=TV Time Tracker <alerts@tvtime.online>
ADMIN_EMAIL=kashivivek@gmail.com

# Web push. Generate once with:
# node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'});console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(k.x,'base64url'),Buffer.from(k.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+k.d)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kashivivek@gmail.com

# Product analytics (optional). Free PostHog project key gives retention/DAU/funnels.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google AdSense
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_LEFT_SLOT=
NEXT_PUBLIC_ADSENSE_RIGHT_SLOT=
