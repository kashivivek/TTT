{
  "name": "tv-time-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "node scripts/build-app-bundle.mjs --publish && next build",
    "build:web": "next build",
    "build:app": "node scripts/build-app-bundle.mjs",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "npm run build:app && cap sync",
    "android": "npm run build:app && cap sync android && cap open android",
    "android:run": "npm run build:app && cap run android",
    "android:dev": "sh scripts/android-dev.sh",
    "android:tv": "bash scripts/android-tv.sh",
    "android:apk": "npm run build:app && cap sync android && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:app && cap sync android && cd android && ./gradlew bundleRelease",
    "android:keystore": "sh scripts/android-keystore.sh",
    "ios": "npm run build:app && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.52.1",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
